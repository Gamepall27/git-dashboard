{
  "name": "git-dashboard",
  "version": "0.2.0",
  "description": "A cross-platform workspace for local Git repositories and configurable analytics",
  "author": {
    "name": "Joshua Baumann",
    "email": "baumann@dial.de"
  },
  "homepage": "https://github.com/Gamepall27/git-dashboard",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gamepall27/git-dashboard.git"
  },
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "build": {
    "appId": "de.gamepall.gitdashboard",
    "productName": "Git Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
